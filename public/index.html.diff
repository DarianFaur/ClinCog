+  .lp-eyebrow {
+    font-family: var(--font-mono);
+    font-size: var(--text-eyebrow-size);
+    font-weight: var(--text-eyebrow-weight);
+    letter-spacing: var(--text-eyebrow-spacing);
+    text-transform: uppercase;
+    color: var(--text-secondary);
+    margin: 0 0 14px;
+  }
+  .lp-title {
+    font-size: clamp(2rem, 1.35rem + 2.6vw, 3.25rem);
+    line-height: 1.08;
+    letter-spacing: -.028em;
+    font-weight: 700;
+    color: var(--text-primary);
+    margin: 0 0 18px;
+  }
+  /* A deliberate line break in the headline, dropped on narrow
