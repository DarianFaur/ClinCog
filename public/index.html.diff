+    position: relative;
+    overflow: hidden;
+    background: var(--bg-surface);
+    border: 1px solid var(--border);
+    border-radius: var(--radius-lg);
+    padding: clamp(28px, 3.4vw, 40px);
+    box-shadow: var(--shadow-sm);
+  }
+  /* The wash is strongest across the top, behind the mark, and is gone
