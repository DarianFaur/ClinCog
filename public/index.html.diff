+  /* ============================================================
+     Landing gate.
+
+     Stylesheets deliberately match the dashboard: tokens.css +
+     components.css, nothing else. The old splash loaded styles.css
+     as well, and styles.css repaints .btn-primary as a green
+     gradient and .btn-secondary as an outlined pill - which is why
+     the first screen's buttons looked nothing like the buttons the
+     student meets one click later. Without it, .btn-primary is the
+     same near-black pill as "Start case" and "Evaluate".
+
+     Everything page-specific is scoped to .lp-* so it cannot collide
+     with shared rules, and every colour comes from tokens.css.
+     ============================================================ */
+  body {
+    background: var(--bg-app);
+    color: var(--text-primary);
+    margin: 0;
+    font-family: var(--font-sans);
+  }
+  /* A single very quiet wash behind the headline. The panel carries
+     the visible gradient, so this stays near the threshold. */
+  .lp-page::before {
+    content: "";
+    position: fixed;
+    inset: 0;
+    pointer-events: none;
+    background: radial-gradient(900px 620px at 8% -12%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%);
+  }
+  .lp-page {
+    position: relative;
+    min-height: 100dvh;
+    display: flex;
+    flex-direction: column;
+    box-sizing: border-box;
+    padding: clamp(20px, 4vw, 48px);
+  }
+  .lp-inner {
+    position: relative;
+    margin: auto;
+    width: 100%;
+    max-width: 1140px;
+    display: grid;
+    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
+    gap: clamp(32px, 5vw, 72px);
+    align-items: center;
+    animation: lp-rise .55s cubic-bezier(.2,.8,.2,1) both;
+  }
+  @keyframes lp-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
+
+  /* ---- left column ---- */
+  .lp-brand {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    margin-bottom: clamp(24px, 4vw, 38px);
+  }
+  .lp-brand img { width: 40px; height: auto; display: block; }
+  .lp-brand strong {
+    font-size: 1.25rem;
+    font-weight: 700;
+    letter-spacing: -.015em;
+    color: var(--text-primary);
+  }
+  /* Same treatment as the dashboard's "CONTINUE YOUR CASE · WEEK 1 ·
+     PSYCHOSIS" eyebrow: mono, uppercase, tracked, and muted rather
