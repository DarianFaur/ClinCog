+  .lp-break { display: block; }
+  @media (max-width: 760px) { .lp-break { display: none; } }
+  .lp-lead {
+    font-size: var(--text-lg);
+    line-height: 1.6;
+    color: var(--text-secondary);
+    max-width: 34em;
+    margin: 0 0 clamp(26px, 3.5vw, 36px);
+  }
+
+  /* ---- the name gate ----
+     The field copies the app's own text fields (benchmarks.html):
+     filled with --bg-surface-alt, no border, --radius-md, and an
+     inset accent outline on focus. The button is plain .btn
+     .btn-primary, so it is the same control as "Start case" on the
+     dashboard - no local overrides at all. */
+  .lp-form { display: flex; gap: var(--sp-3); max-width: 460px; align-items: stretch; }
+  .lp-form input {
+    flex: 1;
+    min-width: 0;
+    height: 44px;
