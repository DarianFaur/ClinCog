+  html[data-theme="dark"] .lp-panel::before {
+    background:
+      linear-gradient(150deg, color-mix(in srgb, var(--accent) 13%, transparent) 0%, transparent 58%),
+      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 11%, transparent), transparent 60%);
+  }
+  .lp-panel-mark {
+    position: relative;
+    display: block;
+    width: clamp(112px, 15vw, 148px);
+    height: auto;
+    margin: 0 auto clamp(24px, 3vw, 30px);
+    opacity: .85;
+  }
+  /* Hairline-separated rows rather than cards inside a card - nesting
+     surfaces here would read as a table. */
+  .lp-lenses { position: relative; display: grid; margin: 0; padding: 0; list-style: none; }
+  .lp-lens {
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr);
+    gap: var(--sp-4);
+    align-items: start;
+    padding: var(--sp-4) 0;
+    border-top: 1px solid var(--border);
+  }
+  .lp-lens:first-child { border-top: none; padding-top: 0; }
+  .lp-lens:last-child { padding-bottom: 0; }
+  /* the dashboard's .lens-icon chip, with a number instead of a glyph */
+  .lp-lens-num {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 34px;
+    height: 34px;
+    border-radius: var(--radius-md);
+    background: var(--accent-soft);
+    /* the numeral is text, not an icon, so it takes the body ink
+       rather than --accent-ink, which would land near 3.9:1 */
+    color: var(--text-primary);
+    font-family: var(--font-mono);
+    font-size: .75rem;
+    font-weight: 600;
+    letter-spacing: .04em;
+  }
+  .lp-lens-title { font-size: var(--text-sm); font-weight: 600; color: var(--text-primary); margin: 0 0 3px; }
+  .lp-lens-desc { font-size: var(--text-xs); line-height: 1.55; color: var(--text-secondary); margin: 0; }
+
+  /* ---- footnotes, in normal flow so nothing can overlap ---- */
+  .lp-foot {
+    position: relative;
+    margin: clamp(32px, 4vw, 48px) auto 0;
+    width: 100%;
+    max-width: 1140px;
+    padding-top: 18px;
+    border-top: 1px solid var(--border);
+    display: flex;
+    flex-wrap: wrap;
+    gap: 6px 22px;
+    align-items: baseline;
+    font-size: var(--text-xs);
